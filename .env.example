# ============================================
# VIB — Configuration SMTP (template)
# ============================================
# Copier ce fichier en .env et remplir les valeurs.
# Le fichier .env est ignoré par Git (voir .gitignore).
# Sur cPanel : déposer le .env dans /home/villageiratybiar/public_html/

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=noreply@example.com
SMTP_PASS=replace_me
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME="VILLAGE Iraty-Biarritz"
SMTP_TO=contact@example.com
SMTP_TO_NAME="Contact VIB"
# Copies éventuelles, séparées par des virgules (optionnel)
SMTP_CC=copie1@example.com,copie2@example.com

# ============================================
# Cloudflare Turnstile (anti-spam formulaire contact)
# ============================================
# Dashboard Cloudflare > Turnstile > le widget du domaine.
# La site key est publique (dupliquee en dur dans contact.html).
# Si TURNSTILE_SECRET_KEY est vide, send.php n'applique PAS la verification
# Turnstile (le formulaire continue de fonctionner, protege par le honeypot et
# le filtrage de contenu). Le fait est trace dans logs/spam.log.
TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=replace_me
